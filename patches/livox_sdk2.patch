-      (reinterpret_cast<size_t>(p) + 15) & static_cast<size_t>(~15));
-  const char *endAligned = reinterpret_cast<const char *>(
-      reinterpret_cast<size_t>(end) & static_cast<size_t>(~15));
-  if (nextAligned > end) return true;
-
-  while (p != nextAligned)
-    if (*p < 0x20 || *p == '\"' || *p == '\\') {
-      is.src_ = p;
