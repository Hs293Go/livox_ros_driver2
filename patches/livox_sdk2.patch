-  while (p != nextAligned)
-    if (*p < 0x20 || *p == '\"' || *p == '\\') {
-      is.src_ = p;
-      return RAPIDJSON_LIKELY(is.Tell() < length);
-    } else
-      os_->PutUnsafe(*p++);
