-    bool escaped = false;
-    if (low == 0) {
-      if (high != 0) {
-        uint32_t lz = RAPIDJSON_CLZLL(high);
-        len = 8 + (lz >> 3);
-        escaped = true;
-      }
-    } else {
-      uint32_t lz = RAPIDJSON_CLZLL(low);
-      len = lz >> 3;
-      escaped = true;
-    }
-    if (RAPIDJSON_UNLIKELY(escaped)) {  // some of characters is escaped
