-            break;
-          }
-          n = m;
-        }
-      }
-
-      token->index = isNumber ? n : kPointerInvalidIndex;
-      token++;
-    }
-
-    RAPIDJSON_ASSERT(name <=
-                     nameBuffer_ + length);  // Should not overflow buffer
-    parseErrorCode_ = kPointerParseErrorNone;
-    return;
-
-  error:
-    Allocator::Free(tokens_);
-    nameBuffer_ = 0;
-    tokens_ = 0;
-    tokenCount_ = 0;
-    parseErrorOffset_ = i;
-    return;
-  }
