-  void Prefix(Type type) {
-    (void)type;
-    if (RAPIDJSON_LIKELY(level_stack_.GetSize() !=
-                         0)) {  // this value is not at root
-      Level *level = level_stack_.template Top<Level>();
-      if (level->valueCount > 0) {
-        if (level->inArray)
