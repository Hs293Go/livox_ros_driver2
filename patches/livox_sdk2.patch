-    // Maps from ASCII to Token
-    static const unsigned char tokenMap[256] = {
-        N16,  // 00~0F
-        N16,  // 10~1F
-        N,           N,
-        StringToken, N,
-        N,           N,
-        N,           N,
-        N,           N,
-        N,           N,
-        CommaToken,  N,
-        N,           N,  // 20~2F
-        N,           N,
-        N,           N,
-        N,           N,
-        N,           N,
-        N,           N,
-        ColonToken,  N,
-        N,           N,
-        N,           N,  // 30~3F
-        N16,             // 40~4F
-        N,           N,
-        N,           N,
-        N,           N,
-        N,           N,
-        N,           N,
-        N,           LeftBracketToken,
-        N,           RightBracketToken,
-        N,           N,  // 50~5F
-        N,           N,
-        N,           N,
-        N,           N,
-        FalseToken,  N,
-        N,           N,
-        N,           N,
-        N,           N,
-        NullToken,   N,  // 60~6F
-        N,           N,
-        N,           N,
-        TrueToken,   N,
-        N,           N,
-        N,           N,
-        N,           LeftCurlyBracketToken,
-        N,           RightCurlyBracketToken,
-        N,           N,  // 70~7F
