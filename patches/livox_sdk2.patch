-  // The rest of string using SIMD
-  const uint8x16_t s0 = vmovq_n_u8('"');
-  const uint8x16_t s1 = vmovq_n_u8('\\');
-  const uint8x16_t s2 = vmovq_n_u8('\b');
-  const uint8x16_t s3 = vmovq_n_u8(32);
