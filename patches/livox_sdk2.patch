-template <typename OutputIterator>
-void copy(const char *str, OutputIterator out) {
-  const char *p_curr = str;
-  while (*p_curr) {
-    *out++ = *p_curr++;
-  }
-}
-
-template <typename OutputIterator>
-void copy(char ch, OutputIterator out) {
-  *out++ = ch;
-}
