-        RAPIDJSON_TRANS(0x10);
-        RAPIDJSON_TAIL();
-        RAPIDJSON_TAIL();
-        return result;
-      case 6:
-        RAPIDJSON_TAIL();
-        RAPIDJSON_TAIL();
-        RAPIDJSON_TAIL();
-        return result;
-      case 10:
-        RAPIDJSON_COPY();
-        RAPIDJSON_TRANS(0x20);
-        RAPIDJSON_TAIL();
-        return result;
-      case 11:
-        RAPIDJSON_COPY();
-        RAPIDJSON_TRANS(0x60);
-        RAPIDJSON_TAIL();
-        RAPIDJSON_TAIL();
-        return result;
-      default:
-        return false;
-    }
-#undef RAPIDJSON_COPY
-#undef RAPIDJSON_TRANS
-#undef RAPIDJSON_TAIL
