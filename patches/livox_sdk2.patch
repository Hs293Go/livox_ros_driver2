-  // The rest of string using SIMD
-  static const char dquote[16] = {'\"', '\"', '\"', '\"', '\"', '\"',
-                                  '\"', '\"', '\"', '\"', '\"', '\"',
-                                  '\"', '\"', '\"', '\"'};
-  static const char bslash[16] = {'\\', '\\', '\\', '\\', '\\', '\\',
-                                  '\\', '\\', '\\', '\\', '\\', '\\',
-                                  '\\', '\\', '\\', '\\'};
