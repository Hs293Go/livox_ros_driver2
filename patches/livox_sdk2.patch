-  bool WriteNull() {
-    PutReserve(*os_, 4);
-    PutUnsafe(*os_, 'n');
-    PutUnsafe(*os_, 'u');
-    PutUnsafe(*os_, 'l');
-    PutUnsafe(*os_, 'l');
-    return true;
-  }
