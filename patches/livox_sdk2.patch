- private:
-  // clear stack on any exit from ParseStream, e.g. due to exception
-  struct ClearStackOnExit {
-    explicit ClearStackOnExit(GenericDocument &d) : d_(d) {}
-    ~ClearStackOnExit() { d_.ClearStack(); }
