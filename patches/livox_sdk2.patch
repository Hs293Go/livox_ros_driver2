-    if ((data_.f.flags & kInt64Flag) != 0)
-      return static_cast<double>(
-          data_.n.i64);  // int64_t -> double (may lose precision)
-    RAPIDJSON_ASSERT((data_.f.flags & kUint64Flag) != 0);
