-    buffer[0] = '0';
-    buffer[1] = '.';
-    buffer[2] = '0';
-    return &buffer[3];
-  } else {
-    if (value < 0) {
-      *buffer++ = '-';
-      value = -value;
-    }
-    int length, K;
-    Grisu2(value, buffer, &length, &K);
-    return Prettify(buffer, length, K, maxDecimalPlaces);
-  }
-}
