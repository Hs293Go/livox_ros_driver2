-        return result;
-      case 3:
-        RAPIDJSON_TAIL();
-        RAPIDJSON_TAIL();
-        return result;
-      case 4:
-        RAPIDJSON_COPY();
-        RAPIDJSON_TRANS(0x50);
-        RAPIDJSON_TAIL();
