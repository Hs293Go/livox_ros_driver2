-  // kappa = 0
-  for (;;) {
-    p2 *= 10;
-    delta *= 10;
-    char d = static_cast<char>(p2 >> -one.e);
-    if (d || *len) buffer[(*len)++] = static_cast<char>('0' + d);
-    p2 &= one.f - 1;
-    kappa--;
