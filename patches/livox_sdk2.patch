-      _mm_loadu_si128(reinterpret_cast<const __m128i *>(&dquote[0]));
-  const __m128i bs =
-      _mm_loadu_si128(reinterpret_cast<const __m128i *>(&bslash[0]));
-  const __m128i sp =
